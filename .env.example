# Copy this file to `.env` and fill values locally. Never commit `.env`.

# Schwab Market Data API (read-only live-preview lane).
# The setup helper stores the Client Secret in macOS Keychain.
SCHWAB_API_KEY=""
SCHWAB_CALLBACK_URL="https://127.0.0.1:8182"
SCHWAB_TOKEN_PATH="/Users/yourname/Library/Application Support/Carsyn Research/Schwab/shared-market-data-tokens.json"
SCHWAB_ENTITLEMENT="NP"
SCHWAB_TRADING_ENABLED="false"
LIVE_MARKET_DATA_PROVIDER="schwab"

# Official ThetaData Python client (primary data path).
THETADATA_API_KEY=""

# Legacy alias for THETADATA_API_KEY (still accepted by the adapter).
THETA_DATA_API_KEY=""

# Optional local overrides.
OPTIONS_CACHE_DIR=".cache/chains"
# (Removed 2026-07-25: THETADATA_USERNAME/PASSWORD/BASE_URL — the local
# ThetaTerminal path is dead; the adapter is keyed HTTP to the remote MDDS.)
# Required by tools/collect_sec_earnings.py (SEC asks for an identifying UA).
SEC_USER_AGENT="project-name contact@example.com"

# Optional: enables tools/daily_ritual.sh's restic backup step (skipped when
# unset or when restic is not on PATH).
RESTIC_REPOSITORY=""
RESTIC_PASSWORD_FILE=""
