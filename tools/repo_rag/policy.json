{
  "application": "options-validator-repo-rag",
  "repository": "options-validator",
  "read_only": true,
  "bounded_writes": true,
  "tracked_files_only": true,
  "corpus_roots": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs",
    "reports",
    "research",
    "wiki",
    "ledger",
    "options_researcher",
    "tests",
    "config.py"
  ],
  "denied_segments": [
    ".env",
    ".git",
    ".venv",
    ".tmp",
    ".cache",
    "__pycache__",
    "data/positions",
    "results",
    "reports/h7_audit"
  ],
  "supported_suffixes": [
    ".md",
    ".txt",
    ".json",
    ".jsonl",
    ".csv",
    ".toml",
    ".py",
    ".html"
  ],
  "source_classes": {
    "registered_hypothesis": [
      "ledger/",
      "docs/superpowers/specs/",
      "docs/h7-forward-operations.md"
    ],
    "frozen_parameters": [
      "config.py",
      "options_researcher/config.py",
      "options_researcher/h7_scope.py",
      "options_researcher/h7_window_registration.py"
    ],
    "derived_backtest": [
      "reports/",
      "options_researcher/h4_backtest.py"
    ],
    "exploratory_notebook": [
      "research/",
      "wiki/",
      "docs/research/"
    ],
    "workflow": [
      "options_researcher/",
      "tests/",
      "docs/superpowers/plans/",
      "README.md",
      "AGENTS.md",
      "CLAUDE.md"
    ]
  }
}
