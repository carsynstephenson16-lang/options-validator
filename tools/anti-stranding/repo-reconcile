#!/bin/zsh
# Daily reconciler: the unconditional floor under all hook-based layers.
# For every repo it can find: back up unpushed branches, rescue dirty worktrees
# and orphaned detached HEADs, open throttled PRs so every branch is visible,
# and write a one-screen plain-language digest. It NEVER forces and NEVER
# deletes; it merges ONLY the owner's own green-check PRs into main in repos
# the owner owns (see README "Merge policy"). Prune of fully-merged clean
# worktrees only with PRUNE=1.
#
#   DRY_RUN=1  -> report what it WOULD do, touch nothing (default: act)
#   PRUNE=1    -> also remove worktrees that are provably merged+clean (default: off)
set +e
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export GIT_TERMINAL_PROMPT=0
DIGEST_CANON="${DIGEST_CANON:-$HOME/.local/state/repo-reconcile/digest.md}"
DIGEST_DESKTOP="${DIGEST_DESKTOP:-$HOME/Desktop/repo-digest.md}"
LOG="$HOME/.local/log/repo-reconcile.log"
MAX_NEW_PRS=3
TODAY=$(date +%Y-%m-%d)
new_prs=0
# Resolved once: side-effect loops (push/PR/merge) only ever act on repos
# whose origin belongs to this GitHub account. ~/codex-plugin-cc is a clone
# of openai/codex-plugin-cc — without this guard the loops would enumerate
# and try to push/PR/merge OTHER PEOPLE'S work there (blocked today only by
# GitHub permissions, which is not a safety design).
GH_LOGIN=$(gh api user -q .login 2>/dev/null)
mkdir -p "$HOME/.local/log" "${DIGEST_CANON:h}"
: >"$DIGEST_CANON.tmp"

say()  { print -r -- "$1" >>"$DIGEST_CANON.tmp"; }
act()  { [ "${DRY_RUN:-0}" = "1" ] && { say "  [dry-run] $1"; return 1; } || return 0; }
logl() { print -r -- "$(date -Iseconds) $1" >>"$LOG"; }

# Branch is safe to publish: gitleaks (when installed) scans the commits that
# would leave the machine. A post-commit gitleaks block must not be undone by
# an unconditional daily retry. Missing gitleaks => scan is skipped (same
# behavior as the post-commit hook) — install it; repos are public.
scan_ok() {  # $1 repo  $2 log-opts range
  command -v gitleaks >/dev/null 2>&1 || return 0
  gitleaks git --no-banner --log-opts="$2" "$1" >/dev/null 2>&1
}

# --- repo discovery: top-level repos in ~ and ~/Documents (worktrees found per-repo)
typeset -a REPOS
for d in "$HOME"/*(N/) "$HOME"/Documents/*(N/); do
  [ -e "$d/.git" ] && REPOS+=("${d%/}")
done

say "# Repo digest — $TODAY"
say ""
NEEDS=0
typeset -A SEEN_GITDIR

for repo in "${REPOS[@]}"; do
  name=${repo:t}
  # Linked worktrees (e.g. options-validator-ops/-research) share one git dir;
  # process each underlying repo exactly once or every action would run N times.
  cdir=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  [ -n "$cdir" ] && { [ -n "${SEEN_GITDIR[$cdir]}" ] && continue; SEEN_GITDIR[$cdir]=1; }
  case "$repo" in
    "$HOME/options-validator-ops"|"$HOME/options-validator-research") ro=1;;
    *) ro=0;;
  esac

  # Safety gate before anything else, keyed on the guard file itself — a
  # renamed or restored validator clone must not skip it on basename grounds.
  # (-f, not -x: the guard is a 644 python file, invoked via uv, never exec'd.)
  if [ -f "$repo/tools/irreplaceable_data_guard.py" ]; then
    if ! (cd "$repo" && uv run python tools/irreplaceable_data_guard.py verify >/dev/null 2>&1); then
      say "## ⛔ $name: irreplaceable-data guard FAILED — no actions taken in this repo. Investigate first."
      NEEDS=1; logl "GUARD FAIL $repo"; continue
    fi
  fi

  git -C "$repo" fetch origin --quiet 2>/dev/null

  # --- every worktree of this repo (incl. the repo itself)
  # sed keeps the full path: awk '{print $2}' truncated paths containing spaces.
  git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | while read -r wt; do
    [ -d "$wt" ] || continue
    # Sanctioned production checkouts are never touched even when reached as
    # linked worktrees of a read-write repo (ro is per-repo, wt is not).
    case "$wt" in
      "$HOME/options-validator-ops"|"$HOME/options-validator-research")
        wt_ro=1;;
      *) wt_ro=$ro;;
    esac
    br=$(git -C "$wt" symbolic-ref --quiet --short HEAD)

    # Dirty tracked changes (working tree OR staged-only) -> rescue commit.
    if ! git -C "$wt" diff --quiet 2>/dev/null || ! git -C "$wt" diff --cached --quiet 2>/dev/null; then
      if [ "$wt_ro" = "1" ] || [ "$br" = "main" ] || [ "$br" = "master" ] || [[ "$br" == deploy/* ]]; then
        say "- ⚠️  $name ${wt:t}: uncommitted changes on protected checkout/branch '${br:-detached}' — left alone, needs you."
        NEEDS=1
      elif [ -n "$br" ] && act "rescue-commit in $wt"; then
        git -C "$wt" commit -a --no-verify -q -m "wip(auto): daily rescue $TODAY" 2>/dev/null \
          && { say "- 💾 $name ${wt:t}: uncommitted work rescued into a WIP commit on $br."; logl "RESCUE $wt $br"; }
      fi
    fi

    # Detached HEAD with commits not in main -> name it so it can't be lost.
    if [ -z "$br" ]; then
      sha=$(git -C "$wt" rev-parse --short HEAD 2>/dev/null)
      if [ -n "$sha" ] && ! git -C "$repo" merge-base --is-ancestor "$sha" origin/main 2>/dev/null; then
        if act "rescue-branch for detached $sha"; then
          git -C "$wt" branch "rescue/detached-$sha" "$sha" 2>/dev/null \
            && say "- 💾 $name: detached worktree ${wt:t} saved as branch rescue/detached-$sha."
        fi
        NEEDS=1
      fi
    fi

    # Untracked AND ignored data is REPORTED, never committed (public repos,
    # secrets; ignored data is exactly what the od1-v2 incident lost).
    unt=$(git -C "$wt" status --short --untracked-files=all 2>/dev/null | grep -c '^??')
    ign=$(git -C "$wt" status --short --ignored=matching --untracked-files=all 2>/dev/null | grep -c '^!!')
    [ "${unt:-0}" != "0" ] && say "- 👀 $name ${wt:t}: $unt untracked file(s) — not committed on purpose; review them."
    [ "${ign:-0}" != "0" ] && say "- 👀 $name ${wt:t}: $ign ignored file(s) (caches/data invisible to git) — check before ANY removal."
  done

  [ "$ro" = "1" ] && continue

  # Ownership gate for every side-effect loop below (push, PR create, merge).
  owner_ok=0
  origin_url=$(git -C "$repo" remote get-url origin 2>/dev/null)
  [ -n "$GH_LOGIN" ] && case "$origin_url" in
    *"/$GH_LOGIN/"*|*":$GH_LOGIN/"*) owner_ok=1;;
  esac
  if [ "$owner_ok" != "1" ]; then
    say "- 👀 $name: origin is not $GH_LOGIN's — inventory only, no push/PR/merge."
    continue
  fi

  # --- push every local branch with commits origin doesn't have (plain push only)
  git -C "$repo" for-each-ref refs/heads --format='%(refname:short)' | while read -r br; do
    case "$br" in main|master|deploy/*) continue;; esac
    if git -C "$repo" rev-parse --verify -q "origin/$br" >/dev/null; then
      ahead=$(git -C "$repo" rev-list --count "origin/$br..$br" 2>/dev/null)
      behind=$(git -C "$repo" rev-list --count "$br..origin/$br" 2>/dev/null)
      range="origin/$br..$br"
    else
      ahead=$(git -C "$repo" rev-list --count "$br" --not --remotes=origin 2>/dev/null); behind=0
      range="$br --not --remotes=origin"
    fi
    [ "${ahead:-0}" = "0" ] && continue
    if ! scan_ok "$repo" "$range"; then
      say "- 🔒 $name/$br: gitleaks flagged unpushed commit(s) — NOT pushed; needs you."
      NEEDS=1; logl "LEAK-BLOCK $repo $br"; continue
    fi
    if [ "${behind:-0}" != "0" ]; then
      say "- ⚠️  $name/$br: diverged from origin ($ahead local vs $behind remote) — backed up as $br-local-backup-$TODAY; reconcile when convenient."
      act "diverged-backup push $br" && git -C "$repo" push --quiet origin "refs/heads/$br:refs/heads/$br-local-backup-$TODAY" 2>/dev/null
      NEEDS=1
    else
      act "push $br" || continue
      if git -C "$repo" push --quiet origin "refs/heads/$br:refs/heads/$br" 2>/dev/null; then
        say "- ☁️  $name/$br: $ahead commit(s) backed up to GitHub."; logl "PUSH $repo $br"
      else
        say "- ⚠️  $name/$br: push FAILED — $ahead commit(s) still exist only on this machine; needs you."
        NEEDS=1; logl "PUSH-FAIL $repo $br"
      fi
    fi
  done

  # --- open PRs (throttled) so every branch with work is visible in one list
  if command -v gh >/dev/null 2>&1 && git -C "$repo" rev-parse --verify -q origin/main >/dev/null; then
    git -C "$repo" for-each-ref refs/heads --format='%(refname:short) %(committerdate:unix)' | sort -k2 | while read -r br ts; do
      case "$br" in main|master|deploy/*|rescue/*|*-local-backup-*) continue;; esac
      [ "$new_prs" -ge "$MAX_NEW_PRS" ] && break
      git -C "$repo" rev-parse --verify -q "origin/$br" >/dev/null || continue
      [ "$(git -C "$repo" rev-list --count "origin/main..origin/$br" 2>/dev/null)" = "0" ] && continue
      # Content already in main (e.g. after a squash-merge) => nothing to PR.
      git -C "$repo" diff --quiet "origin/main" "origin/$br" -- 2>/dev/null && continue
      # Only an OPEN PR suppresses creation: a closed/merged PR on a reused
      # branch name must not hide new commits forever.
      pr=$(cd "$repo" && gh pr list --head "$br" --state open --json number -q 'length' 2>/dev/null)
      [ "${pr:-0}" != "0" ] && continue
      draft=""; [[ "$br" == wip/* ]] && draft="--draft"
      if act "gh pr create for $br"; then
        (cd "$repo" && gh pr create --fill --head "$br" --base main $draft >/dev/null 2>&1) \
          && { say "- 📬 $name/$br: opened a PR so you can review/merge from anywhere."; new_prs=$((new_prs+1)); logl "PR $repo $br"; }
      else
        new_prs=$((new_prs+1))   # dry-run: count so the throttle previews honestly
      fi
    done
  fi

  # --- auto-merge the owner's own green PRs into main (owner-directed
  # 2026-08-15, in-session wording: "i want the merge to be an automatic
  # decision i dont care"). Mechanical guards, all load-bearing:
  #   - owner_ok gate above: never touches repos this account doesn't own
  #   - --base main --author @me: never other bases, never others' PRs
  #   - owner-governed paths (ledger/frozen values/registrations/doctrine/CI)
  #     are excluded and escalated to the digest; if the path inspection
  #     itself fails, the merge is refused (fail closed)
  #   - checks snapshot + --match-head-commit: the merged SHA is exactly the
  #     SHA whose checks were inspected; every check run must be COMPLETED
  #     with an accepted conclusion (a pending run blocks the merge)
  #   - a PR with ZERO checks is reported, never merged
  #   - blackout re-evaluated per PR: no merges 15:00-16:30 ET weekdays (ops
  #     15:30 alignment gate / 15:45 capture)
  #   - failures are reported in the digest, never silent
  automerge_default=$(cat "$HOME/.config/repo-reconcile/automerge" 2>/dev/null || echo 0)
  if [ "${AUTOMERGE:-$automerge_default}" = "1" ] && command -v gh >/dev/null 2>&1; then
    (cd "$repo" && gh pr list --state open --base main --author "@me" --limit 100 \
        --json number,isDraft -q '.[] | select(.isDraft|not) | .number' 2>/dev/null) | while read -r prn; do
      hr=$(TZ=America/New_York date +%H%M); dow=$(TZ=America/New_York date +%u)
      if [ "$dow" -le 5 ] && [ "$hr" -ge 1500 ] && [ "$hr" -le 1630 ]; then
        say "- ⏸  $name PR #$prn: auto-merge paused (ops pre-capture window)."; continue
      fi
      # Fail closed: an API/network error inspecting the diff must not look
      # like "no governed paths".
      if ! files=$(cd "$repo" && gh pr diff "$prn" --name-only 2>/dev/null); then
        say "- ⚠️  $name PR #$prn: could not inspect changed files — merge refused this run."; NEEDS=1; continue
      fi
      if print -r -- "$files" | grep -Eq \
         '^(ledger/|config\.py$|docs/superpowers/|AGENTS\.md$|CLAUDE\.md$|\.cursorrules$|\.github/)'; then
        say "- 🔒 $name PR #$prn: touches owner-governed paths (ledger/frozen/registrations/doctrine/CI) — needs you."
        NEEDS=1; continue
      fi
      # CheckRuns expose status+conclusion; StatusContexts expose state only.
      # Normalize both to STATUS:CONCLUSION and require COMPLETED + accepted.
      snap=$(cd "$repo" && gh pr view "$prn" --json headRefOid,mergeable,statusCheckRollup \
        -q '[.headRefOid,.mergeable,([.statusCheckRollup[] | ((.status // "COMPLETED") + ":" + ((.conclusion // .state) // "PENDING"))] | join(","))] | join(" ")' 2>/dev/null)
      sha=${snap%% *}; rest=${snap#* }; mrg=${rest%% *}; states=${rest#* }
      if [ -z "$states" ] || [ "$states" = "$mrg" ]; then
        say "- ⚠️  $name PR #$prn: no CI checks exist — never auto-merged; needs you."; NEEDS=1; continue
      fi
      if [ "$mrg" != "MERGEABLE" ]; then
        say "- ⚠️  $name PR #$prn: not mergeable ($mrg) — needs you."; NEEDS=1; continue
      fi
      print -r -- "${states//,/$'\n'}" | grep -Eqv '^COMPLETED:(SUCCESS|NEUTRAL|SKIPPED)$' && continue
      act "auto-merge PR #$prn" || continue
      if err=$(cd "$repo" && gh pr merge "$prn" --squash --match-head-commit "$sha" 2>&1); then
        say "- ✅ $name PR #$prn: checks green → merged automatically (owner directive 2026-08-15)."
        logl "AUTOMERGE $repo #$prn"
      else
        say "- ⚠️  $name PR #$prn: auto-merge FAILED — ${err//$'\n'/ }"; NEEDS=1
        logl "AUTOMERGE-FAIL $repo #$prn"
      fi
    done
  fi

  # --- ledger fork escalation (options-validator specific): P0, top of digest
  if [ -d "$repo/ledger" ]; then
    git -C "$repo" for-each-ref refs/heads --format='%(refname:short)' | while read -r br; do
      case "$br" in main|deploy/*) continue;; esac
      if git -C "$repo" diff --quiet "origin/main...$br" -- ledger/ 2>/dev/null; then :; else
        age=$(( ( $(date +%s) - $(git -C "$repo" log -1 --format=%ct "$br") ) / 86400 ))
        say "- ⛔ P0 $name/$br: touches ledger/ and is $age day(s) unmerged — chain-fork risk. Merge or drop soon."
        NEEDS=1
      fi
    done
  fi

  # --- prune fully-merged, clean, no-untracked worktrees (opt-in, reversible)
  if [ "${PRUNE:-0}" = "1" ]; then
    git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p' | while read -r wt; do
      [ "$wt" = "$repo" ] && continue
      case "$wt" in "$HOME/options-validator-ops"|"$HOME/options-validator-research") continue;; esac
      br=$(git -C "$wt" symbolic-ref --quiet --short HEAD) || continue
      # Merged = ancestor of main, OR squash-merged: a MERGED PR exists for
      # the branch AND its tree is content-identical to origin/main.
      merged=0
      if git -C "$repo" merge-base --is-ancestor "$br" origin/main 2>/dev/null; then merged=1
      elif command -v gh >/dev/null 2>&1 \
        && [ "$(cd "$repo" && gh pr list --head "$br" --state merged --json number -q 'length' 2>/dev/null)" != "0" ] \
        && git -C "$repo" diff --quiet "origin/main" "$br" -- 2>/dev/null; then merged=1
      fi
      [ "$merged" = "1" ] || continue
      [ -z "$(git -C "$wt" status --short --ignored=matching --untracked-files=all 2>/dev/null)" ] || continue
      act "worktree remove $wt" && git -C "$repo" worktree remove "$wt" 2>/dev/null \
        && say "- 🧹 $name: removed finished worktree ${wt:t} (branch $br fully landed in main)."
    done
  fi
done

say ""
if [ "$NEEDS" = "0" ]; then
  sed -i '' "1s/.*/# ✅ Everything is backed up — $TODAY/" "$DIGEST_CANON.tmp" 2>/dev/null
else
  sed -i '' "1s/.*/# ⚠️ Some things need you — $TODAY/" "$DIGEST_CANON.tmp" 2>/dev/null
fi
publish_failed=0
if ! mv "$DIGEST_CANON.tmp" "$DIGEST_CANON"; then
  publish_failed=1
  logl "PUBLISH-FAIL $DIGEST_CANON: mv failed"
elif ! cp "$DIGEST_CANON" "$DIGEST_DESKTOP"; then
  publish_failed=1
  logl "PUBLISH-FAIL $DIGEST_DESKTOP: cp failed"
fi
if [ "$publish_failed" = "1" ]; then
  command -v osascript >/dev/null && osascript -e "display notification \"Digest could not be delivered — canonical: $DIGEST_CANON; Desktop: $DIGEST_DESKTOP\" with title \"Repo reconciler publish failed\"" 2>/dev/null
  exit 1
fi
command -v osascript >/dev/null && osascript -e "display notification \"Digest delivered — canonical: $DIGEST_CANON; Desktop: $DIGEST_DESKTOP\" with title \"Repo reconciler ran\"" 2>/dev/null
exit 0
