<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE ONLY; not installed or loaded by this change. Runs the independent
  durable Schwab chain lane at 15:45 ET on weekdays from the ops checkout.
  The existing display-only intraday LaunchAgent remains unchanged.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carsyn.options-validator.schwab-chain-preclose</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/carsynstephenson/options-validator-ops/tools/schwab_chain_capture.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/carsynstephenson/options-validator-ops</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>America/New_York</string>
    <!--
      rev-2.1 item 3a (spec §7 condition 3; owner-ratified 2026-08-14). This
      marker is the ONLY thing that lets a capture receipt claim
      invocation_source="launchd". tools/schwab_chain_capture.sh must never
      set it, or a hand-run capture would forge unattended provenance and the
      S1 bar's condition 3 would be worthless. Reinstalling this plist is
      required for the field to appear on a scheduled run:
        cp tools/launchagents/com.carsyn.options-validator.schwab-chain-preclose.plist \
           ~/Library/LaunchAgents/
        launchctl bootout gui/$(id -u)/com.carsyn.options-validator.schwab-chain-preclose
        launchctl bootstrap gui/$(id -u) \
           ~/Library/LaunchAgents/com.carsyn.options-validator.schwab-chain-preclose.plist
    -->
    <key>OPTIONS_VALIDATOR_INVOCATION_SOURCE</key>
    <string>launchd</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/carsynstephenson/options-validator-ops/.tmp/schwab_chain_capture/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/carsynstephenson/options-validator-ops/.tmp/schwab_chain_capture/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
