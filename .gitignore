.DS_Store
__pycache__/
*.py[cod]

.venv/
.python-version.local

.env
.env.*
!.env.example
.secrets/

# Local Claude Code agent config / permissions -- never commit
# (rules/ and skills/ are shared instruction files and ARE tracked;
#  settings, hooks registration, and other state stay local-only)
.claude/*
!.claude/rules/
!.claude/skills/
!ov/.claude/
!ov/.claude/**
ov/.claude/**/__pycache__/
ov/.claude/**/*.pyc
CLAUDE.local.md

# Serena MCP local config + symbol cache (read/nav tooling; not project files)
.serena/

.cache/
results/*
!results/.gitkeep

# Obsidian vault config (repo opened as a vault; not project files)
.obsidian/
.lumibot/

# Obsidian daily notes & scratch files kept local: their substance is captured
# in tracked docs/ (verification, specs, lessons). Root-anchored so dated docs
# under docs/ (e.g. docs/superpowers/2026-07-02-*.md) stay tracked. Use
# `git add -f` if a specific note ever needs to be committed.
/20??-??-??.md
/Untitled*.md
/Untitled*.canvas
# owner scratch probe of the parked LSE feed (assessment: reports/2026-07-23-
# lse-feed-assessment.md); untracked by design — ruff skips gitignored files
/test_lse_feed.py

# session scratch (web research cache)
.firecrawl/

# disposable intermediates (WAT convention)
.tmp/

# scheduled research-refresh kill-switch (touch to disable the LaunchAgent run)
.research-refresh-off

# superpowers brainstorming companion scratch (mockups, not deliverables)
.superpowers/
node_modules/

# Crawlee local run output
storage/
